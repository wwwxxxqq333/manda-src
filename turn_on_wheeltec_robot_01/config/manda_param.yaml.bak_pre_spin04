# ============================================================
# manda 底盘参数 (4WID-4WIS 前后轮阿克曼 CAN 桥接)
# ============================================================
# 说明: 该包为模块化底盘驱动, 同一个可执行文件 + 不同 yaml 即可适配不同车型。
#       将来新增车型时, 复制本文件并修改参数即可, 无需改动源码。
#
# manda V2.17 架构 (对应 CAN 协议 V1.24):
#   运动模式 : 只使用 0x01 前后轮阿克曼 —— VCU 自行解算四轮转角与轮速
#   下发方式 : 只发 0x402 的 Vx / Vy(恒 0) / Vz
#   转向方式 : 全部靠"边走边转"的圆弧 (R >= native_min_turning_radius)
#   规划/控制: Nav2 用单一 REEDS_SHEPP 规划器 + 单一 MPPI (含阿克曼约束)
#   倒车     : 允许, 限速 0.05 m/s (否则无法退出死胡同)
#
# 【本版已彻底删除的功能: 原地旋转 (0x04)】
#   删除方式不是"用参数关掉", 而是把相关代码路径、状态机分支、
#   参数声明与行为插件从工程中真正移除。当前代码里不存在任何
#   可以构造出 0x401#04 或 "Vx=0 且 Vz≠0" 的入口。
#   删除依据 (2026-09-17 现场抓包):
#     · 底盘桥正确下发了 0x402(Vx=0, Vz≠0) 纯旋转指令
#     · 但 0x104 的 mode 字段 749 帧全部为 0x01, VCU 从未进入 0x04
#     · 0x01 阿克曼在 Vx=0 时物理上无法旋转 -> 车原地不动
#     · Nav2 表现为 "Failed to make progress" 反复出现 + 反复 BackUp
#   现在唯一合法的速度组合:
#     |Vx| >= min_moving_speed  ->  |Vz| <= |Vx| / R_min   (沿圆弧行驶)
#     |Vx| <  min_moving_speed  ->  Vx = 0 且 Vz = 0       (停车)
#   ⚠ 注意: Vz 本身没有被禁用 —— 否则车就无法拐弯。被禁的只是 "Vx=0 且 Vz≠0"。
#
# 为什么不用 0x08 逐轮控制:
#   0x08 下上位机让前轮转向、后轮锁直, 小转弯半径时前后轮瞬时运动方向
#   不一致, 轮胎只能靠侧滑释放几何冲突 (表现为后轮顶前轮、轮胎滑一下)。
#   0x01 由 VCU 按真正的阿克曼几何解算前后轮反向转角与内外轮差速,
#   更符合 4WID-4WIS 的机械能力。
# ============================================================

/**:
  ros__parameters:
    # ---- 车型标识 ----
    car_model: "manda_4wid_4wis_native_front_rear_ackermann"

    # ---- CAN 接口配置 ----
    can_device: "can0"          # SocketCAN 接口名 (can转usb 后一般为 can0)
    bitrate: 500000             # CAN 波特率 (500kbps)
    use_system_can_setup: true  # 启动时是否自动用 ip link 配置并 up 接口

    # ---- 底盘几何参数 (米/度) ----
    wheel_base_x: 0.24          # 前后半轴距: 质心→前后轮轴纵向距离 (图纸 240mm)
    wheel_base_y: 0.19          # 左右半轮距: 质心→左右轮横向距离 (图纸 190mm)
    wheel_radius: 0.10          # 车轮半径: 与 manda.urdf 中 wheel_rotor 半径一致
    # 以下两项仅旧 0x08 逐轮控制的参考实现使用, 当前运行路径不读取。
    # max_steer_angle 保留为"软件安全边界": 0x01 模式下四轮转角由 VCU 解算,
    # 该值不直接参与控制, 但作为文档化的机械上限, 必须 >= 实际工作角。
    #   车体中心 R=0.50m 时内轮工作角仅 37.75° (atan(0.24/(0.50-0.19))),
    #   45° 是安全上限 (对应几何极限 R=0.43m), 留有余量。
    max_steer_angle: 45.0       # 度: 转向角安全上限 (仅 0x08 参考实现 + 文档)
    max_wheel_speed: 2.0        # m/s: 旧 0x08 单轮速度上限

    # ============================================================
    # 整车运动限制 (0x01 模式下由上位机保证)
    # ------------------------------------------------------------
    # 0x01 的四轮解算交给 VCU 后, 上位机只负责三件事:
    #   1. 整车速度上限 (max_forward_speed / max_reverse_speed / max_angular_vel)
    #   2. 下发前的加速度斜坡 (max_linear_accel / max_angular_accel)
    #   3. 阿克曼约束: |Vx| 太小时停车; |Vx| 足够时 |Vz| <= |Vx| / R_min
    # 注意: 曲率约束不能靠"Vx/Vz 同比例缩小"实现 —— 分子分母同时缩小,
    #       转弯半径完全不变。必须单独限制 |Vz| <= |Vx| / R_min。
    # ============================================================
    # 前后轮反向阿克曼 (0x01 官方运动学) 的车体中心最小转弯半径。
    # 几何: 车体中心 R=0.50m 时 内轮 37.75° / 外轮 19.18°
    #       (atan(a/(R-b)) 与 atan(a/(R+b)), a=0.24, b=0.19)
    # 与 Nav2 的 Smac minimum_turning_radius 和
    # MPPI AckermannConstraints.min_turning_r 必须严格一致 (三处同值)。
    native_min_turning_radius: 0.50 # m: 车体中心最小转弯半径 (R=0.50m)
    # manda 2026-09-28: 0.15 -> 0.2 (提速)
    #   ⚠ 本项是最后一道闸, 也是唯一会“静默”砍速的一层。
    #   若只改 Nav2 的 vx_max 而不改这里, 实际下发仍被限到 0.15。
    #   与 Nav2 vx_max / velocity_smoother.max_velocity[0] 必须一致。
    max_forward_speed: 0.2          # m/s: 前进速度上限 (防侧滑)
    max_reverse_speed: 0.05         # m/s: 倒车速度上限

    # ---- 最低行驶速度 ----
    # 低于此速度视为"没有在走", 此时即使有角速度指令也会把 Vx/Vz 一并归零。
    # 作用: 从数学上排除 "Vx=0 且 Vz≠0" 这一原地旋转唯一可能的速度组合。
    # 为何不能设为 0: 阿克曼约束写作 |Vz| <= |Vx| / R_min, 若 Vx=0 则右侧为 0,
    #   即 Vx=0 时 Vz 必须为 0。若把最低速度设为 0, 约束退化成"任何 Vz 都合法",
    #   纯旋转指令就会直接漏到 CAN 上。必须 > 0。
    # 取值 0.005 m/s = 5mm/s: 远低于任何有效行驶速度 (v_max 0.2),
    #   也高于测速噪声量级, 不会误伤正常行驶。
    min_moving_speed: 0.005         # m/s: 最低行驶速度 (★不得为 0★)

    # manda V2.21 (2026-09-21): true -> false 【禁止倒车】
    #   原警告 (已失效): "allow_reverse 必须保持 true, 只是给行为树 <BackUp>
    #   保留的通道" —— 该前提已消失: <BackUp> 已从两棵在线 BT 和
    #   behavior_plugins 中彻底移除, 不再有节点会发负速度。
    #   现改为 false: 在底盘入口层直接堵死倒车, 与
    #     Nav2 侧 vx_min=0 (禁 MPPI 倒车)
    #     motion_model_for_search=DUBIN (规划器只生成前进路径)
    #     velocity_smoother.min_velocity[0]=0.0
    #   形成四层一致的"全程不倒车"。
    # ⚠ 后果 (知情取舍): 若现场空间不满足阿克曼几何, 系统只能
    #   清图重规划或最终报失败, 不会倒车脱困 —— 窄通道容错度下降。
    #   如需恢复倒车能力, 必须四处同步改回: 本项 true + min_velocity[0]
    #   -0.05 + behavior_plugins 加 backup + BT 加 <BackUp>。
    allow_reverse: false

    # 角速度上限必须满足 R_min = max_forward_speed / max_angular_vel:
    #   0.2 / 0.4 = 0.50 m, 与 native_min_turning_radius 严格相等。
    #   若取 0.2, 则 R_min = 0.2/0.2 = 1.0m -> 改了半径参数也转不动小弯。
    #   两者是同一件事的两个写法, 改一个必须同时改另一个。
    #   (manda 2026-09-28: 随 max_forward_speed 0.15->0.2 同步 0.30->0.4)
    max_angular_vel: 0.4            # rad/s: 角速度上限 (= v_max / R_min)
    # manda 2026-09-28: 0.15 -> 0.2 —— 与 velocity_smoother.max_accel[0] 对齐。
    #   若本值 < smoother 的 max_accel, 底盘会静默削顶 -> 起步变肉、跟不上算。
    #   0.2 m/s² 下从 0 加速到 0.2 m/s 需 1.0s (原 0.10 需 2s, 太肉)。
    max_linear_accel: 0.2           # m/s²: 整车线加速度上限 (下发前斜坡)
    max_angular_accel: 0.3          # rad/s²: 整车角加速度上限 (下发前斜坡)

    # ---- 循环与看门狗 ----
    velocity_loop_hz: 10.0      # 下发 0x402 的循环频率 (Hz)
    watchdog_timeout: 0.5       # cmd_vel 心跳超时 (秒), 超时自动全零急停

    # ============================================================
    # 0x104 角速度标度修正 (按底盘上报模式分别标定!)
    # ------------------------------------------------------------
    # 旧的单一 vz_scale=1.84 是在 0x08 (前轮转向 + 后轮锁直) 下实测的:
    #   左转 90° 时 IMU=99.2° / odom_wheel=53.5°, 回归得 IMU_wz = 1.836×odom_vz。
    # 换成 0x01 官方运动学后 VCU 的解算方法已变, 该系数很可能失效,
    # 因此拆成三个模式独立标定, 0x01/0x04 初始都按协议单位取 1.0。
    #
    # 重新标定流程 (0x01 下必做):
    #   1. 保持 vz_scale_mode_01 = 1.0
    #   2. 分别实测: 前进左转 90° / 前进右转 90° / 倒车左转 90° / 倒车右转 90°
    #   3. 用 IMU 与 odom_wheel 的 yaw 增量回归求出比例, 填回 vz_scale_mode_01
    #   4. 若左/右/前进/倒车所需 scale 差异明显, 说明不是单纯比例误差,
    #      而是机械零位 / 轮胎滑动 / 固件模型问题, 不能再用一个常数硬补
    # ============================================================
    vz_scale_mode_01: 1.0       # 0x01 前后轮阿克曼
    vz_scale_mode_08: 1.84      # 0x08 逐轮控制 (历史标定值, 仅回退对照用)

    # ---- 坐标系 ----
    # 与 EKF (turn_on_wheeltec_robot_01/config/ekf.yaml) 保持一致:
    # EKF odom_frame=odom_combined, base_link_frame=base_footprint
    # 避免 /odom_wheel 的 frame 与 EKF 输出不一致造成潜在混淆
    odom_frame_id: "odom_combined"
    base_frame_id: "base_footprint"

    # ---- 话题名 (可重映射) ----
    cmd_vel_topic: "/cmd_vel"
    odom_topic: "/odom_wheel"
    battery_topic: "/battery_state"
    joint_state_topic: "/joint_states"

    # ---- 0x401 模式切换时序 (协议 V1.24 要求静默 >= 200ms) ----
    mode_switch_silence_ms: 250.0  # ms: 0x401 前后静默期
    mode_switch_timeout_ms: 1500.0 # ms: 等待 0x104 模式确认超时

